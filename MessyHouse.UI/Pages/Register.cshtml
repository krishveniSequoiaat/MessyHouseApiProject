@page
@model MessyHouse.UI.Pages.RegisterModel

<div class="d-flex justify-content-center align-items-center" style="height: 80vh;">
    <div class="card shadow p-4" style="width: 350px;">

        <h3 class="text-center mb-4">Create Account</h3>

        <form id="registerForm">

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" id="regUsername" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" id="regEmail" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" id="regPassword" class="form-control" required />
            </div>

            <button type="submit" id="registerButton" class="btn btn-primary w-100">Register</button>

            <div class="text-danger mt-2" id="registerError"></div>
            <div class="text-success mt-2" id="registerSuccess"></div>

            <div class="mt-3 text-center">
                <a href="/Login">Already have an account? Login</a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>

        const apiBaseUrl = "http://ec2-16-170-224-206.eu-north-1.compute.amazonaws.com:5223";

        $('#registerForm').on('submit', function (e) {
            e.preventDefault();

            $('#registerError').text("");
            $('#registerSuccess').text("");

            let payload = {
                username: $('#regUsername').val(),
                email: $('#regEmail').val(),
                password: $('#regPassword').val()
            };

            $.ajax({
                url: apiBaseUrl + "/register",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function () {
                    $('#registerSuccess').text("Registration successful! Redirecting...");
                    setTimeout(() => {
                        window.location.href = "/Login";
                    }, 1000);
                },
                error: function (xhr) {
                    $('#registerError').text(xhr.responseText.replace(/"/g, ""));
                }
            });
        });
    </script>
}